{
  "schemaVersion": 1,
  "name": "hermes",
  "displayName": "hermes",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": { "HERMES_HOME": "${WORKSPACE}/.hermes" },
  "preflight": [{ "path": "${WORKSPACE}/.hermes", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "hermes",
    "launch": ["launch-hermes"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
